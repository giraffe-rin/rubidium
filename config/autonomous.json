{
  "default_branch": "ruca-logic",
  "problem_dir": "problems/restricted-stone-game",
  "status_file": "problems/restricted-stone-game/STATUS.md",
  "lean_dir": "lean",
  "lake_package_directory": "lean",
  "lean_library": "Rubidium",
  "problem_definition_file": "lean/Rubidium/Game.lean",
  "problem_definition_symbol": "Rubidium.IsP",
  "main_theorem_name": "MainTheorem",
  "proved_index_file": "claims/proved/index.json",
  "conjectures_dir": "claims/conjectures",
  "redteam_dir": "code/redteam",
  "dag_file": "data/dag.json",
  "dead_ends_file": "data/dead_ends.jsonl",
  "state_file": "data/state.json",
  "immutable_globs": [
    "problems/*/PROBLEM.md",
    "problems/*/STATUS.md",
    "lean/Rubidium/Game.lean",
    "lean/lakefile.toml",
    "lean/lean-toolchain",
    "claims/proved/**",
    "AGENTS.md",
    "CLAUDE.md",
    "GEMINI.md",
    ".github/**",
    ".claude/**",
    "config/autonomous.json",
    "scripts/autonomous_ops.py",
    "data/dead_ends.jsonl",
    "data/state.json"
  ],
  "allowed_globs": [
    "lean/Rubidium.lean",
    "lean/Rubidium/**/*.lean",
    "lean/check/**/*.lean",
    "claims/conjectures/**/*.json",
    "claims/*.yaml",
    "code/**",
    "data/dag.json",
    "data/*.txt",
    "data/tables/**",
    "notes/**",
    "tests/**"
  ],
  "limits": {
    "max_open_prs": 3,
    "max_daily_prs": 24,
    "stagnation_threshold": 20,
    "subgoal_failure_decompose_threshold": 3,
    "broken_pr_close_hours": 24,
    "stale_pr_close_hours": 72,
    "redteam_timeout_seconds": 60
  }
}
